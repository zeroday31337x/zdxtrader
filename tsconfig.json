{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "state/**/*", "questions/**/*", "policy/**/*", "risk/**/*", "broker/**/*", "filter/**/*", "book/**/*", "logs/**/*", "judge/**/*", "reports/**/*"],
  "exclude": ["node_modules", "dist"]
}
