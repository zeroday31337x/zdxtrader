{
  "name": "jev-trading-desk",
  "version": "0.1.0",
  "description": "Autonomous AI trading desk skeleton: Code owns math/risk, Jev owns judgments, paper only. Follows the strict separation of concerns.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/main.js",
    "dev": "tsx src/main.ts",
    "report": "tsx reports/calibration.ts",
    "dataset": "tsx reports/calibration.ts",
    "verify": "tsc --outDir verified-build && node tests/run.mjs",
    "analyze": "tsx reports/analyze.ts",
    "analyze:meta": "tsx reports/meta-analysis.ts",
    "dataset:once": "tsx reports/calibration.ts --once"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "coinbase-api": "^1.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20"
  }
}
