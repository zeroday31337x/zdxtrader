# Copy to .env and fill in. NEVER commit .env
# Get key at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=your_typesafe_key_here
DESK_SECRET=generate_a_long_random_secret_here
# MODE: shadow | paper | live
MODE=shadow
# Extra safety for live
LIVE_TRADING=false
# Coinbase (trading-only key, NO transfer/withdraw permissions)
# Create at https://www.coinbase.com/settings/api or CDP
COINBASE_API_KEY=
COINBASE_API_SECRET=
# Products to scan (comma-separated)
SCAN_PRODUCTS=BTC-USD,ETH-USD,SOL-USD,DOGE-USD,XRP-USD
# Fee filter (basis points)
ROUND_TRIP_FEE_BPS=150
MIN_EDGE_BUFFER_BPS=50

# Meme swing: explicit Coinbase USD spot allowlist, recommendations only
MEME_PRODUCTS=DOGE-USD,SHIB-USD,PEPE-USD,BONK-USD,WIF-USD,FLOKI-USD,FARTCOIN-USD,PENGU-USD,TOSHI-USD,TRUMP-USD
MEME_SCAN_INTERVAL_MS=300000
MEME_MIN_VOLUME_USD_24H=1000000
MEME_MAX_SPREAD_BPS=30
# Entry notional limits come from MIN_TRADE_USD and MAX_TRADE_USD. Fees are additional.
MAX_POSITION_USD=9

# Exit after the first confirmed live purchase; disable PM2 autorestart for this mode.
STOP_AFTER_PURCHASE=false

# Trading policy, risk, scoring and runtime configuration
MIN_SETUP_SCORE=0.5
MIN_WORTH_TRADING_NOUL=0.5
MAX_TOXICITY_NOUL=0.6
MAX_INVENTORY_RISK_NOUL=0.4
MIN_SPREAD_ATTRACTIVE=0.6
MIN_CONSISTENCY=0.75
MAX_RUG_NOUL=0.2
BASE_SIZE_USD=9
MIN_TRADE_USD=1
MAX_TRADE_USD=9
REQUIRE_UPTREND=false
REQUIRE_SKILLED=true
MIN_PROFIT_EDGE_BPS=10
MIN_PROFIT_CONFIDENCE=0.55
MARKET_REQUEST_INTERVAL_MS=650
MARKET_TIMEOUT_MS=10000
MARKET_RETRY_MS=4000
EDGE_SOURCE_WEIGHT=18
EDGE_SPREAD_WEIGHT=2.5
EDGE_VOLATILITY_WEIGHT=1.5
EDGE_VOLUME_WEIGHT=250
EDGE_IMBALANCE_WEIGHT=500
EDGE_TREND_WEIGHT=1.4
EDGE_MICROTREND_WEIGHT=0.8
SHORT_VOLUME_RATIO_PROXY=1.1
ACCOUNT_BALANCE_FALLBACK_USD=19.5
MAX_ACCOUNT_ALLOCATION=0.49
DAILY_LOSS_LIMIT_USD=10
MAX_DRAWDOWN_PCT=10
MAX_SPREAD_BPS=100.0
HARD_FACT_BENCH_MS=86400000
SPREAD_BENCH_MS=300000
FAILED_ORDER_TTL_MS=300000
POLL_INTERVAL_MS=30000
PAPER_START_BALANCE_USD=10000
PAPER_FEE_BPS=10
MODEL_VERSION=jev-1.13.0
MAX_QUOTE_AGE_MS=30000

# Cross-venue histories and Fibonacci timing
ANALYSIS_EXCHANGES=binance.com,binance.us,crypto.com
EXTERNAL_MARKET_TIMEOUT_MS=8000
BINANCE_COM_API=https://data-api.binance.vision
BINANCE_US_API=https://api.binance.us
CRYPTO_COM_API=https://api.crypto.com/exchange/v1
BINANCE_COM_QUOTE=USDT
BINANCE_US_QUOTE=USDT
CRYPTO_COM_QUOTE=USDT
VENUE_SYMBOL_OVERRIDES={}
GOLDEN_RATIO=1.618033988749895
FIB_LOOKBACK_BARS=30
REQUIRE_FIB_BUY_ZONE=false
MIN_UPWARD_VENUE_FRACTION=0
MIN_TARGET_NET_MARGIN_BPS=0
SLIPPAGE_BUFFER_BPS=20
REQUIRE_TARGET_MARGIN=false
SHORT_HISTORY_BARS=61
HOURLY_HISTORY_BARS=49
ENABLE_AUTO_SELL=true
EXIT_STOP_LOSS_PCT=5
EXIT_TRAILING_PCT=3
EXIT_MAX_HOLD_HOURS=24
EXIT_MIN_PROFIT_BPS=20
SELL_FEE_BPS=75
RECONCILE_MAX_PAGES=10
RECONCILE_PAGE_SIZE=100

# Deterministic execution and UTC scheduling
DECISION_ENGINE=deterministic
MIN_HISTORY_SOURCES=2
MIN_ENTRY_RETURN_5=0
MIN_ENTRY_RETURN_15=0
DETERMINISTIC_MIN_UPWARD_FRACTION=0.5
TRADING_DAYS_UTC=0,1,2,3,4,5,6
TRADING_WINDOWS_UTC=00:00-24:00
ANALYSIS_INTERVAL_MS=300000
MARKET_MAX_RETRIES=3
ORDER_TIMEOUT_MS=10000
BUY_FEE_BPS=75
FIB_BUY_PRIORITY=true
FIB_TIMING_TOLERANCE_MS=600000
COINBASE_MARKET_API=https://api.coinbase.com/api/v3/brokerage/market
VOLUME_WINDOW_BARS=5

# Meta Muse Spark correlation research agent (separate from deterministic execution)
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_CONTEXT_TOKENS=1048576
META_MAX_INPUT_TOKENS=1000000
META_MAX_OUTPUT_TOKENS=8192
META_TOKEN_RESERVE=4096
META_TIMEOUT_MS=180000
META_REASONING_EFFORT=high
META_MAX_CORPUS_BYTES=3200000
META_HISTORY_MAX_FILES=200
META_CHUNK_CHARS=16000
META_ANALYSIS_ENABLED=true
META_ANALYSIS_INTERVAL_MS=3600000
CORRELATION_MIN_SAMPLES=30
CORRELATION_LAGS_BARS=0,1,3,5
META_API_KEY=
ANALYSIS_PROVIDER=meta
META_MAX_FILE_BYTES=512000

# Curated trade and market dataset, every ten minutes
DATASET_ENABLED=true
DATASET_REFRESH_MS=600000
